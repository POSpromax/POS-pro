# Public browser configuration. These values are safe to expose, but RLS must
# still protect every Supabase table.
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_YOUR_KEY"
VITE_CLOUDINARY_CLOUD_NAME="YOUR_CLOUD_NAME"

# Server aliases. SUPABASE_URL is used by Vercel Functions; the publishable
# key remains low privilege and RLS-protected.
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_YOUR_KEY"
SUPABASE_SECRET_KEY="sb_secret_YOUR_SERVER_KEY"

# Server-only Vercel variables. CLOUDINARY_URL contains the API secret: never
# prefix it with VITE_, never commit it, and never expose it to the browser.
CLOUDINARY_URL="cloudinary://YOUR_API_KEY:YOUR_API_SECRET@YOUR_CLOUD_NAME"
CLOUDINARY_UPLOAD_PRESET="pos-pro"

# Alternative to CLOUDINARY_URL (use one style, not both).
# CLOUDINARY_API_KEY="YOUR_API_KEY"
# CLOUDINARY_API_SECRET="YOUR_API_SECRET"
# CLOUDINARY_CLOUD_NAME="YOUR_CLOUD_NAME"

# Owner setup (run once: npm run setup:owner)
OWNER_INITIAL_PIN=""

# Optional legacy integration. Keep empty when unused.
GEMINI_API_KEY=""
APP_URL="http://localhost:3000"
