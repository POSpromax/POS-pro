# Public browser configuration. These values are safe to expose, but RLS must
# still protect every Supabase table.
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_YOUR_KEY"
VITE_CLOUDINARY_CLOUD_NAME="YOUR_CLOUD_NAME"

# Server-only Vercel variables. CLOUDINARY_URL contains the API secret: never
# prefix it with VITE_, never commit it, and never expose it to the browser.
CLOUDINARY_URL="cloudinary://YOUR_API_KEY:YOUR_API_SECRET@YOUR_CLOUD_NAME"
CLOUDINARY_UPLOAD_PRESET="pos-pro"

# Optional legacy integration. Keep empty when unused.
GEMINI_API_KEY=""
APP_URL="http://localhost:3000"
